{
  "name": "run-life-hiroshima",
  "version": "0.1.0",
  "private": true,
  "description": "RUN LIFE HIROSHIMA — 広島発、走ることを暮らしの一部にする個人ランニングメディア",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs && node scripts/shoes/build-db.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run validate && npm test",
    "channels": "node scripts/channels.mjs",
    "shoes:collect": "node scripts/shoes/collect.mjs && node scripts/shoes/build-db.mjs",
    "shoes:db": "node scripts/shoes/build-db.mjs",
    "shoes:audit": "node scripts/shoes/audit.mjs",
    "ameblo:drafts": "node scripts/ameblo/drafts.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "16.4.2",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "type": "module"
}
